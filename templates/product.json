   "params": {
    "scene": "// A product on a seamless studio sweep: a ceramic body, a fabric band,\n// a brushed gold top ring. knob(0) turns it (degrees).\n// Materials: 7 ceramic (preset), 20 fabric, 4 gold (preset), 21 sweep.\nfloat2 map(float3 p) {\n  float2 r = float2(p.y + 1.05, 21.0);\n  r = opU(r, float2(p.z + 6.0, 21.0));\n  float3 q = rotY(p, radians(knob(0)));\n  float body = sdCylinder(q, 0.9, 1.0, 0.25);\n  r = opU(r, float2(body, abs(q.y + 0.15) < 0.45 ? 20.0 : 7.0));\n  r = opU(r, float2(sdTorus(q - float3(0.0, 1.0, 0.0), 0.62, 0.035), 4.0));\n  return r;\n}\nvoid material(float id, float3 p, float3 n, inout float3 albedo, inout float metallic, inout float roughness) {\n  presetMaterial(id, albedo, metallic, roughness);\n  if (id > 19.5 && id < 20.5) {\n    // Woven fabric: a fine cross weave.\n    float3 q = rotY(p, radians(knob(0)));\n    float a = atan2(q.z, q.x) * 45.0;\n    float w = sin(a) * sin(q.y * 70.0);\n    albedo = float3(0.16, 0.17, 0.19) * (0.85 + 0.15 * w);\n    metallic = 0.0; roughness = 0.9;\n  } else if (id > 20.5) {\n    albedo = float3(0.82, 0.80, 0.77); metallic = 0.0; roughness = 0.6;\n  }\n}",
